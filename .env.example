# ── Docker ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
# API_PORT=8000
# WEB_PORT=3000

# ── Backend ───────────────────────────────────────────────────────────────────
# Dev SQLite (default). For Postgres: postgresql+asyncpg://typeflow:<pass>@localhost:5432/typeflow
TYPEFLOW_DATABASE_URL=sqlite+aiosqlite:///./typeflow.db
# Required in production — must be 32+ random bytes (run: openssl rand -base64 32)
TYPEFLOW_JWT_SECRET=change-me-to-a-long-random-string
# TYPEFLOW_JWT_ALGORITHM=HS256
# TYPEFLOW_ACCESS_TOKEN_MINUTES=15
# TYPEFLOW_REFRESH_TOKEN_DAYS=30
# TYPEFLOW_PASSWORD_RESET_MINUTES=30
# TYPEFLOW_ENV=development
TYPEFLOW_CORS_ORIGINS=["http://localhost:3000"]
# false for local HTTP dev; true required for production HTTPS
TYPEFLOW_COOKIE_SECURE=false
# TYPEFLOW_RATE_LIMIT_ENABLED=true
# TYPEFLOW_REGISTRATION_OPEN=true
# TYPEFLOW_LOG_LEVEL=INFO
# TYPEFLOW_LOG_COLOR=true
# TYPEFLOW_LOG_ACCESS=true
# TYPEFLOW_LOG_EXCLUDE_PATHS=["/healthz"]

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public URL of the API as seen from the browser — must match API_PORT
NEXT_PUBLIC_TYPEFLOW_API_URL=http://localhost:8000
