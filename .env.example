# ── Docker ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
API_PORT=8000
WEB_PORT=3000

# ── Backend ───────────────────────────────────────────────────────────────────
# Local SQLite (default for dev):
TYPEFLOW_DATABASE_URL=sqlite+aiosqlite:///./typeflow.db
# Docker / production Postgres (set automatically by docker-compose):
# TYPEFLOW_DATABASE_URL=postgresql+asyncpg://typeflow:change-me@postgres:5432/typeflow

# JWT — use a long random secret in production (32+ bytes)
TYPEFLOW_JWT_SECRET=change-me-to-a-long-random-string

# CORS — JSON array of allowed origins
TYPEFLOW_CORS_ORIGINS=["http://localhost:3000"]

# Set false for local HTTP dev without TLS
TYPEFLOW_COOKIE_SECURE=false

# Rate limiting on /auth/* (disable in tests)
TYPEFLOW_RATE_LIMIT_ENABLED=true

# Set to false to prevent new signups (existing users can still log in)
# TYPEFLOW_REGISTRATION_OPEN=true

# Environment — production startup rejects weak JWT secrets
# TYPEFLOW_ENV=development

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public URL of the API as seen from the browser
NEXT_PUBLIC_TYPEFLOW_API_URL=http://localhost:8000
