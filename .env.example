# Database (async SQLAlchemy URL)
# Local SQLite (default):
# TYPEFLOW_DATABASE_URL=sqlite+aiosqlite:///./typeflow.db
# Docker / production Postgres:
TYPEFLOW_DATABASE_URL=postgresql+asyncpg://typeflow:change-me@localhost:5432/typeflow

# JWT — use a long random secret in production (32+ bytes)
TYPEFLOW_JWT_SECRET=change-me-to-a-long-random-string
TYPEFLOW_JWT_ALGORITHM=HS256
TYPEFLOW_ACCESS_TOKEN_MINUTES=15
TYPEFLOW_REFRESH_TOKEN_DAYS=30

# CORS — JSON array (dev: localhost:3000–3019 for auto-port frontend)
TYPEFLOW_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005","http://localhost:3006","http://localhost:3007","http://localhost:3008","http://localhost:3009","http://localhost:3010","http://localhost:3011","http://localhost:3012","http://localhost:3013","http://localhost:3014","http://localhost:3015","http://localhost:3016","http://localhost:3017","http://localhost:3018","http://localhost:3019"]

# Set false for local HTTP dev without TLS
TYPEFLOW_COOKIE_SECURE=true

# Rate limiting on /auth/* (disable in tests)
TYPEFLOW_RATE_LIMIT_ENABLED=true

# Set to false to prevent new signups (existing users can still log in)
# TYPEFLOW_REGISTRATION_OPEN=true

# Environment — production startup rejects weak JWT secrets
# TYPEFLOW_ENV=development

# Password reset token TTL (minutes)
# TYPEFLOW_PASSWORD_RESET_MINUTES=30

# Logging — colored access logs with latency and request IDs
# TYPEFLOW_LOG_LEVEL=INFO
# TYPEFLOW_LOG_COLOR=true
# TYPEFLOW_LOG_ACCESS=true
# TYPEFLOW_LOG_EXCLUDE_PATHS=["/healthz"]

# Frontend — URL the browser uses to reach the API
NEXT_PUBLIC_TYPEFLOW_API_URL=http://localhost:8000

# Docker compose only — host ports
# API_PORT=8000
# WEB_PORT=3000
