# Docker Compose variables (copy to .env.docker or let onboard.sh create it)
# Postgres password is baked into the volume on first start — if you change it,
# run: docker compose --env-file .env.docker down -v

POSTGRES_PASSWORD=change-me
API_PORT=8080
TYPEFLOW_JWT_SECRET=change-me-to-a-long-random-string
TYPEFLOW_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005","http://localhost:3006","http://localhost:3007","http://localhost:3008","http://localhost:3009","http://localhost:3010","http://localhost:3011","http://localhost:3012","http://localhost:3013","http://localhost:3014","http://localhost:3015","http://localhost:3016","http://localhost:3017","http://localhost:3018","http://localhost:3019"]
TYPEFLOW_COOKIE_SECURE=false
# Set to false to prevent new signups once you've created your accounts
# TYPEFLOW_REGISTRATION_OPEN=true

# Frontend
WEB_PORT=3000
# Public URL of the API as seen from the browser (not the Docker network)
NEXT_PUBLIC_TYPEFLOW_API_URL=http://localhost:8000
